---
import Layout from "../layouts/Layout.astro";
import AboutUs from "../components/Information/AboutUs";
import Product from "../components/Product/Product";
import QueseriaSocial from "../components/QueseriaSocial/QueseriaSocial";
import Footer from "../components/Footer/Footer.astro";
// import { fetchProducts } from "../utils/contentful";
import { fetchProductsDirectly } from "../utils/contentful";
import ButtonWhatsapp from '../components/ButtonWhatsapp/buttonWhatsapp'
import HeroSeccion from "../components/Hero/HeroSeccion"

const { products, lastUpdated } = await fetchProductsDirectly();
---

<Layout>
  <HeroSeccion client:load />
  <ButtonWhatsapp client:load />
  <Product 
  initialProducts={products} 
  initialLastUpdated={lastUpdated}
  client:load />
  <AboutUs client:visible />
  <QueseriaSocial client:load />
  <Footer />
</Layout>


