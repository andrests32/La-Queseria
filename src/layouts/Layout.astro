---
import ClientRouter from 'astro/components/ClientRouter.astro';
import '../styles/global.css';
import LogoQueseria from '../components/LogoQueseria/LogoQueseria';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Básico -->
    <title>Queseria | Fábrica de Quesos y Productos Naturales en Santo Domingo </title>
    <meta name="description" content="Empresa local en Santo Domingo, Ecuador dedicada a la producción artesanal de quesos, derivados del plátano verde, huevos frescos y más." />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href='/queseriaicono.ico' />

    <!-- Open Graph (para compartir en redes sociales) -->
    <meta property="og:title" content="Quesos y Productos Naturales en Santo Domingo - [Nombre de tu empresa]" />
    <meta property="og:description" content="Conoce nuestros productos frescos: quesos, plátano verde, huevos y más, elaborados en Santo Domingo, Ecuador." />
    <meta property="og:image" content="/ruta-a-tu-imagen.jpg" />
    <meta property="og:url" content="https://www.tu-dominio.com/" />
    <meta property="og:type" content="website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Fábrica de Quesos y Productos Naturales | Santo Domingo" />
    <meta name="twitter:description" content="Quesos artesanales, plátano verde, huevos y más desde Santo Domingo, Ecuador." />
    <meta name="twitter:image" content="/ruta-a-tu-imagen.jpg" />

    <!-- Schema.org (para buscadores) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "[Nombre de tu empresa]",
        "url": "https://www.tu-dominio.com/",
        "logo": "https://www.tu-dominio.com/logo.png",
        "description": "Fábrica ecuatoriana de quesos, productos del plátano verde, huevos y más, ubicada en Santo Domingo.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Santo Domingo",
          "addressCountry": "EC"
        }
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
  scroll-behavior: smooth;
</style>
