---
import ClientRouter from "astro/components/ClientRouter.astro";
import "../styles/global.css";
import LogoQueseria from "../components/LogoQueseria/LogoQueseria";
import NavBar from "../components/NavBar/NavBar";

const currentPath = Astro.url.pathname;
const showNavBar = currentPath === "/" || currentPath === "/about";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Título y Descripción SEO -->
    <title>La Quesería EC | Quesos artesanales y productos naturales en Santo Domingo, Ecuador</title>
    <meta name="description" content="Compra quesos artesanales, productos del plátano verde, huevos frescos y más en Santo Domingo, Ecuador. Entrega local y calidad garantizada." />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/queseriaicono.ico" />

    <!-- Canonical URL -->
    <link rel="canonical" href="https://www.laqueseriaec.com/" />

    <!-- Open Graph (para compartir en redes sociales) -->
    <meta property="og:title" content="La Quesería EC | Quesos artesanales y productos naturales en Santo Domingo" />
    <meta property="og:description" content="Quesos frescos, plátano verde, huevos y más. Calidad garantizada desde Santo Domingo, Ecuador. ¡Compra directo del productor!" />
    <meta property="og:image" content="https://www.laqueseriaec.com/images/og-image.jpg" />
    <meta property="og:url" content="https://www.laqueseriaec.com/" />
    <meta property="og:type" content="website" />

    <!-- Meta móviles y tema -->
    <meta name="theme-color" content="#f7f7f7" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <!-- Schema.org (SEO estructurado para Google) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "La Quesería EC",
        "url": "https://www.laqueseriaec.com/",
        "logo": "https://www.laqueseriaec.com/logo.webp",
        "description": "Quesos artesanales, productos del plátano, huevos frescos y más en Santo Domingo, Ecuador.",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Santo Domingo",
          "addressRegion": "Santo Domingo de los Tsáchilas",
          "addressCountry": "EC"
        },
        "sameAs": [
          "https://www.facebook.com/laqueseriaec",
          "https://www.instagram.com/laqueseriaec"
        ]
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    {showNavBar && <NavBar client:load />}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    scroll-behavior: smooth;
  }
</style>
